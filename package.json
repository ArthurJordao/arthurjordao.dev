{
	"name": "cactus",
	"type": "module",
	"version": "8.2.0",
	"scripts": {
		"postinstall": "npm rebuild sharp --force",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"check:routes": "./scripts/check-routes.sh",
		"check:seo": "./scripts/check-seo.sh",
		"check:paste": "npm run cv:linkedin && git diff --exit-code content/cv/",
		"verify": "npm run build && npm run check:routes && npm run check:seo && npm run check:paste",
		"lint": "biome check --write",
		"format": "prettier -w . --cache",
		"cv:linkedin": "tsx scripts/cv-linkedin.ts"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.1",
		"@astrojs/mdx": "^8.0.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.3",
		"astro-expressive-code": "^0.44.0",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^9.0.5",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"satori": "^0.33.4",
		"satori-html": "^0.3.2",
		"satteri": "^0.10.3",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.5.14",
		"@iconify-json/mdi": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.97",
		"@pagefind/default-ui": "^1.5.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.2",
		"autoprefixer": "^10.6.1",
		"mdast-util-to-hast": "^13.2.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.8",
		"prettier-plugin-astro": "^1.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"reading-time": "^1.5.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"sharp": "$sharp"
	},
	"allowScripts": {
		"esbuild": true
	}
}
