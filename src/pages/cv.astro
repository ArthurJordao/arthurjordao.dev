---
import { cv, parseMonth, skills } from "@/data/cv";
import PageLayout from "@/layouts/Base.astro";
import "@/styles/cv.css";
import "@/styles/print.css";

const meta = {
	description: `CV of Arthur Jordão — ${cv.basics.title}, ${cv.basics.tagline}.`,
	title: "CV",
};

/**
 * "2022-04" -> "Apr 2022". Short form here, because the page is dense; the
 * LinkedIn paste file in scripts/cv-linkedin.ts spells the month out, because
 * that is the form LinkedIn's own fields show. Keep the two in step.
 */
const formatMonth = (month: string) =>
	parseMonth(month).toLocaleDateString("en-US", {
		month: "short",
		timeZone: "UTC",
		year: "numeric",
	});

const range = (start: string, end: string | null) =>
	`${formatMonth(start)} — ${end ? formatMonth(end) : "Present"}`;

/** Strip the scheme so a link reads as a label rather than a URL bar. */
const short = (url: string) => url.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<PageLayout meta={meta}>
	<article>
		<h1 class="title mb-1">{cv.basics.name}</h1>
		<p class="text-accent-2">{cv.basics.title} · {cv.basics.tagline}</p>
		<ul class="text-muted mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
			<li>{cv.basics.location}</li>
			<li><a class="cactus-link" href={`mailto:${cv.basics.email}`}>{cv.basics.email}</a></li>
			<li><a class="cactus-link" href={cv.basics.github}>{short(cv.basics.github)}</a></li>
			<li><a class="cactus-link" href={cv.basics.linkedin}>{short(cv.basics.linkedin)}</a></li>
		</ul>

		<p class="mt-8">{cv.summary}</p>

		<section class="cv-section mt-10">
			<h2 class="cv-section-title">Experience</h2>
			{
				cv.positions.map((position) => (
					<div class="cv-entry">
						<div class="cv-entry-head">
							<h3 class="cv-entry-role">{position.title}</h3>
							<span class="cv-entry-dates">{range(position.start, position.end)}</span>
						</div>
						<p class="cv-entry-where">
							{position.company} · {position.location}
						</p>
						<p class="cv-entry-summary">{position.summary}</p>
						<ul class="cv-bullets">
							{position.highlights.map((highlight) => (
								<li>{highlight}</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<section class="cv-section">
			<h2 class="cv-section-title">Education</h2>
			{
				cv.education.map((entry) => (
					<div class="cv-entry">
						<div class="cv-entry-head">
							<h3 class="cv-entry-role">{entry.qualification}</h3>
							<span class="cv-entry-dates">
								{entry.start} — {entry.end}
							</span>
						</div>
						<p class="cv-entry-where">{entry.institution}</p>
					</div>
				))
			}
		</section>

		<section class="cv-section">
			<h2 class="cv-section-title">Skills</h2>
			<p>{skills.join(", ")}</p>
		</section>

		<section class="cv-section">
			<h2 class="cv-section-title">Languages</h2>
			<dl class="cv-list">
				{
					cv.languages.map((entry) => (
						<>
							<dt>{entry.language}</dt>
							<dd>{entry.level}</dd>
						</>
					))
				}
			</dl>
		</section>
	</article>
</PageLayout>
